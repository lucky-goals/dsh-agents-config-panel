{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx"],
  "exclude": ["node_modules", "lib", "dist", "test", "**/*.test.ts", "**/*.test.tsx"]
}
